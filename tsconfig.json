{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",

    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,

    "rootDir": "./webapp",
    "outDir": "./dist",

    "paths": {
      "at/clouddna/demo/*": [
        "./webapp/*"
      ],
      "unit/*": [
        "./webapp/test/unit/*"
      ],
      "integration/*": [
        "./webapp/test/integration/*"
      ]
    },

    "types": [
      "@sapui5/types"
    ]
  },
  "include": [
    "./webapp/**/*"
  ]
}
